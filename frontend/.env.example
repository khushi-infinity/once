# ONCE frontend environment: copy to frontend/.env.local (never committed).
# The Next.js dev server proxies /api/* and /health to this URL; the browser
# stays same-origin, so no AWS credentials ever reach the frontend.
BACKEND_URL=http://localhost:8000
# Self-hosted MCP server (Streamable HTTP). The FastAPI process mounts it at
# /mcp; the /alexa page proxies /mcp here. Use :8765 only for the standalone
# `python -m app.mcp_server` smoke process.
MCP_URL=http://localhost:8000
