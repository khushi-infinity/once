# ONCE backend environment: copy to backend/.env (NEVER commit backend/.env).
# Every AWS call in live mode goes through the default credential chain with
# the least-privilege identity from AWS_SETUP.md ("once-local"): never root.

# "mock": in-memory stores (offline dev + tests). "live": real AWS.
APP_MODE=live
# Mock-only: seed the three curated demo skills so /alexa and /recall work
# without any AWS credentials. Set false for an empty in-memory store.
SEED_DEMO=true

AWS_REGION=us-east-1
# Named profile holding the least-privilege AWS identity (AWS_SETUP.md).
AWS_PROFILE=once-local

DYNAMODB_SKILLS_TABLE=ONCE_Skills
DYNAMODB_SESSIONS_TABLE=ONCE_Sessions
DYNAMODB_GRANTS_TABLE=ONCE_Grants
S3_EVIDENCE_BUCKET=once-evidence-552952091217

# Browser origins allowed to call this API (comma separated)
CORS_ORIGINS=http://localhost:3000
# MCP Streamable HTTP host/origin allowlist (comma separated). Keep the local
# entries for dev; add the deployed host and web origin in the cloud.
MCP_ALLOWED_HOSTS=localhost:*,127.0.0.1:*
MCP_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# AI inference: choose exactly one primary provider with INFERENCE_PROVIDER.
#   openai-compatible = local Ollama or any OpenAI-compatible endpoint
#   openrouter        = hosted OpenAI-compatible endpoint (deployable path)
#   gemini            = Google AI Studio (Interactions API)
# Never commit a real key. A fallback is optional and is labeled in responses.
INFERENCE_PROVIDER=openai-compatible
INFERENCE_FALLBACK_PROVIDER=
INFERENCE_MAX_TOKENS=2048
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_API_KEY=ollama
OPENAI_MODEL=qwen2.5-coder:7b
# Vision-capable model for photo teaching (empty = same as OPENAI_MODEL)
OPENAI_VISION_MODEL=qwen2.5vl:3b

# Google AI Studio (optional; currently account-blocked for this project).
GEMINI_API_KEY=
GEMINI_MODEL_ID=gemini-3.8-flash
GEMINI_FALLBACK_MODEL_ID=gemini-3.5-flash-lite

# OpenRouter (hosted, OpenAI-compatible). Never commit a real key.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3.8-flash
OPENROUTER_VISION_MODEL=google/gemini-3.8-flash
