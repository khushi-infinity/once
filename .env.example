# ONCE environment variables — copy to real .env files per app.
# NEVER commit a real .env. AWS credentials come from the AWS credential
# provider chain (e.g. `aws login`), never from files in this repository.

# ---------------- backend/backend/.env ----------------
# "mock" = in-memory stores, stubbed AI (offline dev/tests)
# "live" = real AWS calls; failures surface as errors, never as fakes
APP_MODE=mock

AWS_REGION=us-east-1
BEDROCK_MODEL_ID=amazon.nova-2-lite-v1:0
DYNAMODB_SKILLS_TABLE=ONCE_Skills
DYNAMODB_SESSIONS_TABLE=ONCE_Sessions
S3_EVIDENCE_BUCKET=

# ---------------- frontend/frontend/.env.local ----------------
# Backend the dev proxy connects to:
BACKEND_URL=http://localhost:8000
