# ONCE environment variables: copy to backend/.env and frontend/.env.local.
# NEVER commit a real .env. AWS credentials come from the AWS credential
# provider chain (e.g. `aws login` + a least-privilege IAM identity),
# never from files in this repository. See AWS_SETUP.md.

# ---------------- backend/.env ----------------
# "mock" = in-memory stores (offline dev/tests)
# "live" = real AWS calls; failures surface as errors, never as fakes
APP_MODE=live
AWS_REGION=us-east-1
# Named profile holding the least-privilege AWS identity (AWS_SETUP.md)
AWS_PROFILE=once-local
DYNAMODB_SKILLS_TABLE=ONCE_Skills
DYNAMODB_SESSIONS_TABLE=ONCE_Sessions
DYNAMODB_GRANTS_TABLE=ONCE_Grants
S3_EVIDENCE_BUCKET=once-evidence-552952091217
CORS_ORIGINS=http://localhost:3000

# ---------------- inference (free tier) ----------------
# Google AI Studio key: free at aistudio.google.com (never commit a real key)
GEMINI_API_KEY=
GEMINI_MODEL_ID=gemini-3.8-flash
GEMINI_FALLBACK_MODEL_ID=gemini-3.5-flash-lite
# Inference provider (explicit; never auto-switched):
#   openai-compatible = local Ollama or any OpenAI-compatible endpoint
#   gemini            = Google AI Studio (Interactions API)
INFERENCE_PROVIDER=openai-compatible
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_API_KEY=ollama
OPENAI_MODEL=qwen2.5-coder:7b
# Vision-capable model for photo teaching (empty = same as OPENAI_MODEL)
OPENAI_VISION_MODEL=qwen2.5vl:3b


# ---------------- frontend/.env.local ----------------
# Backend the Next.js dev proxy connects to
BACKEND_URL=http://localhost:8000
